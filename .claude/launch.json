{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "portfolio-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "h2-proxy",
      "runtimeExecutable": "node",
      "runtimeArgs": [".verify/h2-proxy.mjs"],
      "port": 3443,
      "url": "https://localhost:3443"
    }
  ]
}
